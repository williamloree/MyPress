{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPress",
  "version": "0.1.1",
  "identifier": "fr.williamloree.mypress",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MyPress",
        "width": 460,
        "height": 560,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["French", "English"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFREI4NzQxQkVDNUFGRTAKUldUZ3I4VytRWWZiVGtRYWcxZVJoaWZMQjdhaEErRXVSWEcwQzVuUnNLRUkzNXkwT3dFdVVJMkEK",
      "endpoints": ["https://github.com/williamloree/MyPress/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
